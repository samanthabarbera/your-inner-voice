# Anthropic (Claude) — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ElevenLabs — get from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Supabase — get from supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Frontend API URL — set in Vercel to point at your Railway backend
VITE_API_URL=https://your-railway-app.railway.app/api

# Production only — set in Railway
PORT=3001
NODE_ENV=production
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
